 "hero": "  <div class=\"wrap hero\">\n    <div class=\"hero-copy\">\n      <a class=\"where soon-pill\" href=\"#join\" data-focus-email>The Howlback app is coming soon. Get first word</a>\n      <h1>Helping the street dogs of the Valley.</h1>\n      <p class=\"lead\">Who to call, where to get low-cost care, and the rescues and neighbors doing the work across South Texas. All in one place.</p>\n      <div style=\"display:flex;gap:10px;flex-wrap:wrap\"><a class=\"btn\" href=\"#help\">Find local help</a><a class=\"btn soft\" href=\"#stories\">Read the stories</a></div>\n    </div>\n    <div class=\"photo\">\n      <img src=\"img/street-dog.jpg\" alt=\"A tan and black street dog with big ears sitting on concrete, looking up at the camera\" width=\"900\" height=\"919\">\n    </div>\n  </div>\n",
 "join": "  <section class=\"join\">\n    <div class=\"wrap\">\n      <div class=\"join-copy\">\n        <h2>Stay in the loop</h2>\n        <p class=\"lead\">Local stories, upcoming clinics, and first word when the Howlback app launches. By email or text, your pick.</p>\n      </div>\n    <div class=\"signup\" id=\"join\">\n      <div class=\"sw\" role=\"group\" aria-label=\"How should we reach you?\">\n        <button type=\"button\" aria-pressed=\"true\" data-mode=\"email\">Email me</button>\n        <button type=\"button\" aria-pressed=\"false\" data-mode=\"text\">Text me</button>\n      </div>\n      <div id=\"mode-email\">\n        <label for=\"email\">Email address</label>\n        <form id=\"signup\" action=\"https://howlback.beehiiv.com/subscribe\" method=\"get\" target=\"_blank\">\n          <input id=\"email\" name=\"email\" type=\"email\" placeholder=\"you@email.com\" autocomplete=\"email\" required>\n          <button class=\"btn\" type=\"submit\">Sign up</button>\n        </form>\n        <small>Free. Unsubscribe anytime.</small>\n      </div>\n      <div id=\"mode-text\" hidden>\n        <label for=\"phone\">Phone number</label>\n        <form id=\"textform\" name=\"launch-text\" method=\"POST\" data-netlify=\"true\" netlify-honeypot=\"company\">\n          <input type=\"hidden\" name=\"form-name\" value=\"launch-text\">\n          <p hidden><label>Leave this empty <input name=\"company\"></label></p>\n          <input id=\"phone\" name=\"phone\" type=\"tel\" inputmode=\"tel\" placeholder=\"(956) 555-0123\" autocomplete=\"tel\" pattern=\"[0-9()+\\-. ]{10,}\" required>\n          <button class=\"btn\" type=\"submit\">Text me</button>\n        </form>\n        <small>We\u2019ll text you once when the app launches. By signing up you agree to get texts from Howlback. Msg and data rates may apply. Reply STOP to opt out.</small>\n        <p class=\"ok\" id=\"text-ok\" hidden>You\u2019re on the list! We\u2019ll text you when the app is out.</p>\n        <p class=\"err\" id=\"text-err\" hidden>That didn\u2019t go through. Check your number and try again.</p>\n      </div>\n    </div>\n    </div>\n  </section>",
 "feat": "  <section class=\"feat\" id=\"featured\">\n    <div class=\"wrap\">\n      <div style=\"display:flex;flex-direction:column;gap:14px\">\n        <h2>Have a rescue story? Share it.</h2>\n        <p class=\"lead\" style=\"color:var(--ink)\">We feature local fosters, rescuers, and adopted dogs in the Howlback newsletter. Rescues and businesses can also reach us here to update a listing.</p>\n      </div>\n      <div class=\"box\">\n        <b>Email us your story</b>\n        <div class=\"mail\"><code id=\"addr\">hello@howlback.app</code></div>\n        <div class=\"mail\"><a class=\"btn\" href=\"mailto:hello@howlback.app?subject=My%20rescue%20story\" style=\"padding:10px 18px\">Open email</a><button class=\"btn soft\" type=\"button\" id=\"copy\" style=\"padding:10px 18px\">Copy address</button></div>\n        <p>Include:</p>\n        <ul>\n          <li>The dog\u2019s name and city</li>\n          <li>How you found them and how they\u2019re doing now</li>\n          <li>2 or 3 photos you took</li>\n          <li>How you\u2019d like to be credited</li>\n        </ul>\n        <small class=\"muted\">By sending photos you confirm they\u2019re yours and okay for us to share.</small>\n      </div>\n    </div>\n  </section>",
 "footer": "<footer>\n  <div class=\"wrap\">\n    <div style=\"display:flex;flex-direction:column;gap:12px\">\n      <a class=\"logo\" href=\"#top\">howl<i>back</i></a>\n      <p class=\"fine\">Local help, rescues, and stories for the street dogs of South Texas.</p>\n      <p class=\"fine\">Listings are for information only. Call ahead to confirm hours and services.</p>\n    </div>\n    <div style=\"display:flex;flex-direction:column;gap:12px\">\n      <b>Follow Howlback</b>\n      <div class=\"social\">\n        <a href=\"https://www.instagram.com/howlback.app\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><circle cx=\"17.5\" cy=\"6.5\" r=\"1\" fill=\"currentColor\"/></svg>Instagram</a>\n        <a href=\"https://www.facebook.com/profile.php?id=61595201828343\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M14 8h3V4h-3c-2.8 0-4 1.7-4 4.3V10H7v4h3v7h4v-7h3l1-4h-4V8.6c0-.4.3-.6.6-.6z\"/></svg>Facebook</a>\n        <a href=\"https://www.tiktok.com/@howlback.app\" target=\"_blank\" rel=\"noopener\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M16 3c.4 2.4 1.9 4 4.5 4.2v3.4c-1.6 0-3.1-.5-4.4-1.4v6.3A5.5 5.5 0 1 1 10.6 10v3.5a2 2 0 1 0 1.9 2V3z\"/></svg>TikTok</a>\n        <a href=\"#join\" data-focus-email><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg>Get email updates</a>\n      </div>\n      <p class=\"fine\">Contact: hello@howlback.app<br>\u00a9 2026 Howlback</p>\n    </div>\n  </div>\n</footer>",
 "found": "        <div class=\"found\">\n          <h3>Found a stray? Start here.</h3>\n          <ol>\n            <li>Keep yourself safe. Don\u2019t grab a scared or hurt dog.</li>\n            <li>Get them scanned for a microchip. Many vets and shelters do it free.</li>\n            <li>Post a photo in your city\u2019s lost and found pets group.</li>\n            <li>Can\u2019t keep them? Call your city\u2019s shelter or animal control below.</li>\n          </ol>\n        </div>\n",
